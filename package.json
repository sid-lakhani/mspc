{
  "name": "mspc",
  "version": "0.1.0",
  "private": true,
  "description": "Michael Scott Paper Company — a self-hosted, open-source AI agent workspace. Run a virtual office of autonomous AI coding agents in your browser, managed by a server-side agent runtime.",
  "author": "Siddhesh Lakhani",
  "license": "MIT",
  "homepage": "https://github.com/sid-lakhani/mspc",
  "repository": {
    "type": "git",
    "url": "https://github.com/sid-lakhani/mspc.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite src/renderer",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build src/renderer",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "npm run typecheck:server && npm run typecheck:client",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck:client": "tsc --noEmit -p tsconfig.web.json",
    "test": "node --test test/*.test.cjs",
    "start": "node out/server/index.js"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@monaco-editor/react": "^4.7.0",
    "@openai/agents-realtime": "^0.11.8",
    "@uiw/react-codemirror": "^4.25.10",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.10.0",
    "commit-graph": "^2.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "i18next": "^26.3.6",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.0.0",
    "pixi.js": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
